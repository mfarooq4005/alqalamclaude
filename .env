# ═══════════════════════════════════════════════════════════════
#   AL QALAM INTERNATIONAL — EMS Environment Configuration
#   File: .env  |  Copy as .env and fill in your real values
#   IMPORTANT: Never commit this file to git / public repo!
# ═══════════════════════════════════════════════════════════════

# ─── APPLICATION ───────────────────────────────────────────────
APP_NAME="AL Qalam International EMS"
APP_URL=http://localhost/alqalam
APP_ENV=local                      # local | production
APP_DEBUG=true
APP_KEY=base64:ALQalamSecretKey2024ChangeMeNow==
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=ur
APP_SESSION=2024-25
APP_VERSION=2.0

# ─── DATABASE (MySQL / XAMPP) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alqalam_ems
DB_USERNAME=root
DB_PASSWORD=123456                       # Leave blank for XAMPP default

# ─── JWT AUTHENTICATION ─────────────────────────────────────────
JWT_SECRET=ALQalamJWT_Secret_Change_This_In_Production
JWT_EXPIRY=86400                   # Token valid for 24 hours (seconds)
JWT_ALGO=HS256

# ─── WHATSAPP — TWILIO ──────────────────────────────────────────
# Register at: https://www.twilio.com/whatsapp
# Free sandbox available for testing
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# School's WhatsApp number (for replies)
SCHOOL_WHATSAPP=+92300XXXXXXX

# ─── WHATSAPP — META BUSINESS API (Production alternative) ──────
# Register at: https://developers.facebook.com/docs/whatsapp
META_WA_TOKEN=your_meta_whatsapp_token
META_WA_PHONE_ID=your_phone_number_id

# ─── EMAIL (SMTP) ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=school@alqalam.edu.pk
MAIL_PASSWORD=your_app_password_here
MAIL_FROM_ADDRESS=noreply@alqalam.edu.pk
MAIL_FROM_NAME="AL Qalam International"

# ─── SCHOOL SETTINGS ────────────────────────────────────────────
SCHOOL_NAME="AL Qalam International"
SCHOOL_BRANCH_NAME="Main Campus"
SCHOOL_PHONE=021-XXXXXXXX
SCHOOL_MOBILE=0300-XXXXXXX
SCHOOL_EMAIL=info@alqalam.edu.pk
SCHOOL_ADDRESS="Block X, North Karachi, Karachi"
SCHOOL_REG_NO=KACHI-EDU-2024-XXXX
SCHOOL_BANK_NAME="MCB Bank Limited"
SCHOOL_BANK_ACCOUNT=1234567890
SCHOOL_BANK_BRANCH="Karachi Branch"
SCHOOL_BANK_IBAN=PK00MCB0000001234567890

# ─── FEE SETTINGS ───────────────────────────────────────────────
FEE_LATE_CHARGE_PER_DAY=20        # Rs. per day after due date
FEE_GRACE_PERIOD_DAYS=5           # Days after due before late fee starts
FEE_ANNUAL_INCREASE_PERCENT=10    # % increase each new session
FEE_CHALLAN_EXPIRY_DAYS=30        # Challan expires after this many days
FEE_RECEIPT_PREFIX=RCP
FEE_CHALLAN_PREFIX=CH
FEE_VOUCHER_PREFIX=VCH
FEE_SIBLING_DISCOUNT_PERCENT=10   # Auto discount for 2nd+ sibling
FEE_ADVANCE_DISCOUNT_PERCENT=5    # Discount for paying 3+ months advance

# ─── SMS SETTINGS (optional) ────────────────────────────────────
SMS_PROVIDER=twilio                # twilio | eocean | jazzcash
SMS_API_KEY=your_sms_api_key

# ─── REPORTS ────────────────────────────────────────────────────
REPORT_LOGO_PATH=assets/logo.png
REPORT_FOOTER="AL Qalam International School — Excellence in Education"
REPORT_WATERMARK=OFFICIAL

# ─── STORAGE ────────────────────────────────────────────────────
STORAGE_DRIVER=local               # local | s3
UPLOAD_MAX_SIZE=10M
ALLOWED_UPLOADS=pdf,jpg,png,docx

# ─── CACHE ──────────────────────────────────────────────────────
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── SECURITY ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── XAMPP DEPLOYMENT STEPS ─────────────────────────────────────
# 1. Install XAMPP from apachefriends.org
# 2. Copy all files to: C:\xampp\htdocs\alqalam\
# 3. Start Apache + MySQL in XAMPP Control Panel
# 4. Open phpMyAdmin → Create DB: alqalam_ems
# 5. Import alqalam_database.sql
# 6. Copy this .env file, fill in values
# 7. Open: http://localhost/alqalam/alqalam_ems.html
# ────────────────────────────────────────────────────────────────
